{
  "name": "ember",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#doc-model": "./packages/doc-model/src/index.ts",
    "#canvas-engine": "./packages/canvas-engine/src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test \"tests/**/*.test.ts\"",
    "ai:test": "cargo test --manifest-path src-tauri/Cargo.toml ai::",
    "gate:cycles": "node scripts/gates/cycles.mjs",
    "gate:layers": "node scripts/gates/layers.mjs",
    "gate:bans": "node scripts/gates/bans.mjs",
    "gate": "node scripts/gates/all.mjs",
    "gate:selftest": "node scripts/gates/selftest.mjs",
    "check:offline": "node scripts/gates/offline.mjs",
    "check:runtime": "node scripts/gates/runtime-network.mjs",
    "check:network": "pnpm run build && pnpm run check:offline && pnpm run check:runtime",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run gate && pnpm run check:network && pnpm run test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "5.107.1",
    "@tauri-apps/api": "2.12.4",
    "katex": "0.19.1",
    "mdast-util-to-string": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8"
  }
}
